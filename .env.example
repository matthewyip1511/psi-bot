# Paste values immediately after the = sign. Do not add spaces around =.

# Telegram token from @BotFather (required)
TELEGRAM_BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE

# data.gov.sg source API key (optional; leave blank if you do not have one)
DATA_GOV_SG_API_KEY=

# Destination channel (required): @public_username or a numeric -100... ID
TELEGRAM_CHANNEL_ID=PASTE_TELEGRAM_CHANNEL_ID_HERE

# Optional settings
SEND_ON_STARTUP=true
LOG_LEVEL=INFO
